# Common
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost,http://127.0.0.1

# Prisma
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://boardgames:boardgames@postgres:5432/boardgames?schema=public

# For local SQLite fallback (uncomment and switch DATABASE_PROVIDER=sqlite)
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./dev.db

# JWT
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Postgres container
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=boardgames

# Frontend
VITE_API_URL=

# Test credentials (seed + UI presets)
TEST_USER_USERNAME=demo_user
TEST_USER_EMAIL=demo@example.com
TEST_USER_PASSWORD=DemoUser123!
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminUser123!
VITE_TEST_USER_EMAIL=demo@example.com
VITE_TEST_USER_PASSWORD=DemoUser123!
VITE_TEST_ADMIN_EMAIL=admin@example.com
VITE_TEST_ADMIN_PASSWORD=AdminUser123!
