# Production environment variables example
# Copy to .env.production and replace ALL values before deploying.
NODE_ENV=production
PORT=4000

# Database - PostgreSQL
DATABASE_PROVIDER=postgresql
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql://boardgames:changeme_strong_password@postgres:5432/boardgames?schema=public

# JWT / Auth — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# CORS — set to your domain (comma-separated for multiple)
CLIENT_ORIGIN=https://your-domain.com

# Frontend API URL — leave empty to use relative origin (recommended behind nginx)
# Set only if API is on a different domain.
VITE_API_URL=
