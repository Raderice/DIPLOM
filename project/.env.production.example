# Production environment variables example
# Replace values with your production secrets before deploying.
NODE_ENV=production
PORT=4000

# Database - PostgreSQL
DATABASE_PROVIDER=postgresql
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Frontend
VITE_API_URL=http://localhost:4000
CLIENT_ORIGIN=http://your-domain.com

# JWT / Auth (set secure secrets)
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Prisma (if using SQLite in production set provider to sqlite and provide path)
# DATABASE_PROVIDER=sqlite
# DATABASE_URL=file:./dev.db
